node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Expo
.expo/
.expo-shared/
apps/mobile/android/
apps/mobile/ios/

# Real Aurora saves and characters are personal data — never commit them.
# They stay local and are read as test fixtures only (ADR 0012, CLAUDE.md).
*.dnd5e
*.incu
fixtures/local/

# The one exception: tools/incudo/fixtures/ holds a save the tests generate, not a real
# one. Today it is committed in the unpacked folder form (plain .json, reviewable in a
# diff — the reason ADR 0012 keeps that form at all), so nothing here is ignored anyway.
# The rule exists so adding a packed golden .incu later does not need this argued again.
!tools/incudo/fixtures/**/*.incu

# Local content cache / scratch
.incudo-cache/
tmp/
scratch/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
.env
.env.local

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Incudo window is allowed to do. See apps/desktop/README.md for why the HTTP scope is as wide as it is, and why the filesystem scope is as narrow.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }],
      "deny": [{ "url": "http://**" }]
    },
    "dialog:allow-open",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists"
  ]
}

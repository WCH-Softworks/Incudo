{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Incudo window is allowed to do. See apps/desktop/README.md for why content is fetched by the app's own command, https only, and why the filesystem scope is as narrow as it is: the library folder the user picks, and the app's own sources folder (ADR 0119).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/sources"
        },
        {
          "path": "$APPDATA/sources/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/sources"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/WCH-Softworks/Incudo"
        },
        {
          "url": "https://patreon.com/incudo"
        },
        {
          "url": "https://ko-fi.com/willcaphir"
        }
      ]
    }
  ]
}

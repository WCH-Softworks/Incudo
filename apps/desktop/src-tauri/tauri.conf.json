{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incudo",
  "version": "0.1.0",
  "identifier": "dev.incudo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @incudo/desktop",
    "devUrl": "http://localhost:41730",
    "beforeBuildCommand": "npm run build -w @incudo/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Incudo",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}

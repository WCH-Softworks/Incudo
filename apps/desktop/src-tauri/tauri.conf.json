{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incudo",
  "version": "1.1.0",
  "identifier": "dev.incudo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @incudo/desktop",
    "devUrl": "http://localhost:41730",
    "beforeBuildCommand": "npm run build -w @incudo/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Incudo",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5Q0ZENEVERjhFNDg2N0EKUldSNmh1VDQ3ZFRQcVplSGZ4YUR5dTE0b1hockp5YXMvWFduWDVjRFNMejVlc3VoVUtISW5jT2IK",
      "endpoints": [
        "https://github.com/WCH-Softworks/Incudo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

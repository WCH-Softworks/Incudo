{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incudo",
  "version": "0.0.1",
  "identifier": "dev.incudo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @incudo/desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @incudo/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Incudo",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

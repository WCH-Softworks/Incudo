{
  "expo": {
    "name": "Incudo",
    "slug": "incudo",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "scheme": "incudo",
    "android": {
      "package": "com.wchsoftworks.incudo",
      "versionCode": 1000199,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/octet-stream",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "application/octet-stream",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/backup-rules.cjs",
      "./plugins/debug-symbols.cjs",
      "expo-sqlite",
      "expo-status-bar"
    ]
  }
}

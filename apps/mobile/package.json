{
  "name": "@incudo/mobile",
  "version": "1.0.1",
  "private": true,
  "description": "Incudo mobile shell (Expo). Layout and platform I/O only.",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./zip": "./src/zip.ts"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "build:android": "expo run:android --no-bundler",
    "start:build": "expo start --dev-client"
  },
  "dependencies": {
    "@incudo/aurora-import": "*",
    "@incudo/content": "*",
    "@incudo/core": "*",
    "@incudo/ui": "*",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~58.0.26",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}

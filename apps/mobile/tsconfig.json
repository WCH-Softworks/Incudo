{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-types",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": [
      "react-native"
    ],
    "jsx": "react-jsx",
    "types": [],
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "app.json",
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/content"
    },
    {
      "path": "../../packages/aurora-import"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}

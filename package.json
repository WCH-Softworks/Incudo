{
  "name": "incudo",
  "version": "0.0.1",
  "private": true,
  "description": "A modern, system-agnostic tabletop character builder for desktop and mobile. A free and open replacement for Aurora Builder.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/desktop",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean",
    "test": "node --env-file-if-exists=.env.local --test --experimental-strip-types \"packages/*/src/**/*.test.ts\" \"tools/*/src/**/*.test.ts\"",
    "fixtures:rebuild": "node --experimental-strip-types tools/verify/src/rebuild-fixtures.ts",
    "corpus:sync": "node --experimental-strip-types tools/verify/src/corpus-sync.ts",
    "lint": "eslint .",
    "desktop": "npm run dev -w @incudo/desktop",
    "desktop:app": "npm run tauri:dev -w @incudo/desktop",
    "desktop:build": "npm run build -w @incudo/desktop",
    "mobile": "npm run start -w @incudo/mobile",
    "mobile:android": "npm run android -w @incudo/mobile"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}

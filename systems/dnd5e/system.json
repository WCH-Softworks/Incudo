  "characterKinds": [
    {
      "id": "pc",
      "name": "Player Character",
      "description": "Levels 1–20, a class, a background, and the two-page sheet everyone means when they say \"character\".",
      "default": true,
      "progression": { "kind": "level", "min": 1, "max": 20, "stat": "level", "elementIdPattern": "ID_LEVEL_{n}", "trackStatPattern": "level:{name}", "trackType": "Class" },

      "stats": [
        { "name": "level", "label": "Level", "default": 1 },
        { "name": "hp", "label": "Hit Points", "default": 0,
          "derive": { "kind": "binary", "op": "+", "left": { "kind": "binary", "op": "+", "left": { "kind": "binary", "op": "*", "left": { "kind": "ref", "stat": "hp:average" }, "right": { "kind": "ref", "stat": "hp:average:dice" } }, "right": { "kind": "binary", "op": "*", "left": { "kind": "binary", "op": "-", "left": { "kind": "number", "value": 1 }, "right": { "kind": "ref", "stat": "hp:average" } }, "right": { "kind": "rolls", "pattern": "hp:level:{n}" } } }, "right": { "kind": "binary", "op": "*", "left": { "kind": "ref", "stat": "constitution:modifier" }, "right": { "kind": "ref", "stat": "level" } } } },

        {
          "name": "ac", "label": "Armor Class",
          "derive": {
            "kind": "binary", "op": "+",
            "left": {
              "kind": "binary", "op": "+",
              "left": {
                "kind": "call", "fn": "max",
                "args": [
                  { "kind": "ref", "stat": "ac:calculation" },
                  {
                    "kind": "binary", "op": "+",
                    "left": {
                      "kind": "binary", "op": "+",
                      "left": { "kind": "ref", "stat": "ac:armored:armor" },
                      "right": {
                        "kind": "call", "fn": "max",
                        "args": [
                          { "kind": "ref", "stat": "ac:armored:dexterity:floor" },
                          { "kind": "call", "fn": "min",
                            "args": [
                              { "kind": "ref", "stat": "dexterity:modifier" },
                              { "kind": "ref", "stat": "ac:armored:dexterity:cap" }
                            ] }
                        ]
                      }
                    },
                    "right": { "kind": "ref", "stat": "ac:armored:enhancement" }
                  }
                ]
              },
              "right": { "kind": "ref", "stat": "ac:shield" }
            },
            "right": { "kind": "ref", "stat": "ac:misc" }
          }
        },

        { "name": "speed", "label": "Speed",
          "derive": { "kind": "binary", "op": "+",
            "left": { "kind": "binary", "op": "+",
              "left": { "kind": "ref", "stat": "innate speed" },
              "right": { "kind": "ref", "stat": "innate speed:misc" } },
            "right": { "kind": "ref", "stat": "speed:misc" } } },

        { "name": "attunement:current", "label": "Attuned Items", "default": 0 },
        { "name": "attunement:max", "label": "Attunement Limit", "default": 0 }
      ],

      "grants": [
        "ID_INTERNAL_GRANTS_CHARACTER_BASE",
        "ID_INTERNAL_GRANTS_ARMOR_CLASS_BASE",
        "ID_INTERNAL_GRANTS_ARMOR_CLASS_DEXTERITY_MODIFIER",
        "ID_INTERNAL_GRANTS_HP_CONSTITUTION_MODIFIER",
        "ID_INTERNAL_GRANTS_SPELLCASTING_BASE",
        "ID_INTERNAL_GRANTS_MULTICLASS_SPELLCASTING",
        "ID_INTERNAL_GRANTS_MULTICLASSING_PREREQUISITE"
      ],

      "trackStats": [
        { "stat": "hp:average:dice", "value": { "kind": "binary", "op": "+", "left": { "kind": "binary", "op": "*", "left": { "kind": "ref", "stat": "track:progress" }, "right": { "kind": "binary", "op": "+", "left": { "kind": "call", "fn": "floor", "args": [{ "kind": "binary", "op": "/", "left": { "kind": "setter", "name": "hd", "as": "dieSides" }, "right": { "kind": "number", "value": 2 } } ] }, "right": { "kind": "number", "value": 1 } } }, "right": { "kind": "binary", "op": "*", "left": { "kind": "ref", "stat": "track:first" }, "right": { "kind": "binary", "op": "-", "left": { "kind": "setter", "name": "hd", "as": "dieSides" }, "right": { "kind": "binary", "op": "+", "left": { "kind": "call", "fn": "floor", "args": [{ "kind": "binary", "op": "/", "left": { "kind": "setter", "name": "hd", "as": "dieSides" }, "right": { "kind": "number", "value": 2 } } ] }, "right": { "kind": "number", "value": 1 } } } } } },
        { "stat": "multiclass:spellcasting:level", "when": "ID_INTERNAL_GRANT_MULTICLASS_SPELLCASTING_SLOTS_FULL", "value": { "kind": "ref", "stat": "track:progress" } },
        { "stat": "multiclass:spellcasting:level", "when": "ID_INTERNAL_GRANT_MULTICLASS_SPELLCASTING_SLOTS_HALF", "value": { "kind": "call", "fn": "floor", "args": [{ "kind": "binary", "op": "/", "left": { "kind": "ref", "stat": "track:progress" }, "right": { "kind": "number", "value": 2 } }] } },
        { "stat": "multiclass:spellcasting:level", "when": "ID_INTERNAL_GRANT_MULTICLASS_SPELLCASTING_SLOTS_THIRD", "value": { "kind": "call", "fn": "floor", "args": [{ "kind": "binary", "op": "/", "left": { "kind": "ref", "stat": "track:progress" }, "right": { "kind": "number", "value": 3 } }] } },
        { "stat": "{name}:spellcasting:solo", "when": "ID_INTERNAL_GRANT_MULTICLASS_SPELLCASTING_SLOTS_SOLO", "value": { "kind": "number", "value": 1 } }
      ],

      "blockStats": [
        { "stat": "{name}:spellcasting:dc",
          "value": { "kind": "binary", "op": "+",
            "left": { "kind": "number", "value": 8 },
            "right": { "kind": "binary", "op": "+",
              "left": { "kind": "ref", "stat": "proficiency" },
              "right": { "kind": "binary", "op": "+",
                "left": { "kind": "ref", "stat": "{ability}:modifier" },
                "right": { "kind": "ref", "stat": "spellcasting:dc" } } } } },
        { "stat": "{name}:spellcasting:attack",
          "value": { "kind": "binary", "op": "+",
            "left": { "kind": "ref", "stat": "proficiency" },
            "right": { "kind": "binary", "op": "+",
              "left": { "kind": "ref", "stat": "{ability}:modifier" },
              "right": { "kind": "ref", "stat": "spellcasting:attack" } } } }
      ],

      "blockFilters": [
        { "key": "spellcasting:list", "tags": ["{list}", "{name}"] },
        { "key": "spellcasting:slots", "tagsFromStats": ["{name}:spellcasting:slots:*", "spellcasting:slots:*"], "fillFrom": 1 }
      ],

      "setterTags": [
        { "setter": "isRitual", "tag": "Ritual" }
      ],

      "preparation": {
        "blockAttribute": "prepare",
        "limit": "{name}:spellcasting:prepare",
        "elementType": "Spell",
        "heldSelect": "Spellbook",
        "listFilter": "$(spellcasting:list), $(spellcasting:slots)",
        "heldFilter": "$(spellcasting:slots)"
      },

      "contributions": [
        { "stat": "hp:average", "value": { "kind": "number", "value": 1 }, "requirements": "ID_INTERNAL_OPTION_ALLOW_AVERAGE_HP" },

        { "stat": "ac:armored:armor", "value": { "kind": "number", "value": 10 }, "requirements": "[armor:none]" },

        { "stat": "ac:armored:dexterity:cap", "value": { "kind": "number", "value": 99 }, "bonus": "base", "requirements": "![armor:medium],![armor:heavy]" },
        { "stat": "ac:armored:dexterity:cap", "value": { "kind": "number", "value": 2 }, "bonus": "base", "requirements": "[armor:medium]" },
        { "stat": "ac:armored:dexterity:cap", "value": { "kind": "number", "value": 0 }, "bonus": "base", "requirements": "[armor:heavy]" },

        { "stat": "ac:armored:dexterity:floor", "value": { "kind": "number", "value": -99 }, "bonus": "base", "requirements": "![armor:heavy]" },
        { "stat": "ac:armored:dexterity:floor", "value": { "kind": "number", "value": 0 }, "bonus": "base", "requirements": "[armor:heavy]" },

        { "stat": "attunement:max", "value": { "kind": "number", "value": 3 }, "bonus": "base" }
      ],

      "inventory": {
        "slotSetter": "slot",
        "occupiedTag": "any",
        "emptyTag": "none",
        "tagSetters": ["armor"],
        "flagSetters": ["versatile"],
        "slots": [
          { "id": "body", "label": "Armor", "stats": ["armor"] },
          { "id": "onehand,secondary", "label": "Shield", "stats": ["shield"] },
          { "id": "onehand", "label": "Hands", "stats": ["primary", "secondary"] },
          { "id": "twohand", "label": "Two-Handed", "stats": ["primary"] },
          { "id": "head", "label": "Head" },
          { "id": "neck", "label": "Neck" },
          { "id": "shoulders", "label": "Shoulders" },
          { "id": "arms", "label": "Arms" },
          { "id": "hands", "label": "Gloves" },
          { "id": "waist", "label": "Waist" },
          { "id": "belt", "label": "Belt" },
          { "id": "legs", "label": "Legs" },
          { "id": "feet", "label": "Feet" },
          { "id": "ring", "label": "Rings" },
          { "id": "misc", "label": "Carried" },
          { "id": "gift", "label": "Supernatural Gift" },
          { "id": "companion", "label": "Companion" }
        ],
        "attunement": { "setter": "attunement", "requires": "true", "countStat": "attunement:current", "maxStat": "attunement:max" }
      },

      "repeatableSetter": "allow duplicate",

      "candidateNotes": [
        { "types": ["Spell"], "setter": "level", "label": "Level {value}", "labels": { "0": "Cantrip" } }
      ],

      "elementTypes": [

  "generationMethods": [
    { "id": "point-buy", "label": "Point buy", "pool": 27, "min": 8, "max": 15,
      "costs": { "8": 0, "9": 1, "10": 2, "11": 3, "12": 4, "13": 5, "14": 7, "15": 9 } },
    { "id": "standard-array", "label": "Standard array", "values": [15, 14, 13, 12, 10, 8] },
    { "id": "roll", "label": "Roll", "dice": "4d6dl1", "count": 6 },
    { "id": "manual", "label": "Enter manually", "min": 1, "max": 30 },
    { "id": "entry", "label": "Enter manually", "min": 0 }

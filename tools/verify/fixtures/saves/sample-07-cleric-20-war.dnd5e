					<element type="Background Feature" name="Variant Feature" requiredLevel="1" checksum="4188fc3f" registered="" />
					<element type="List" name="Personality Trait" requiredLevel="1" number="1" checksum="4c3beea5" isList="true" registered="7">I’ve enjoyed fine food, drink, and high society among my temple’s elite. Rough living grates on me.</element>
					<element type="List" name="Personality Trait" requiredLevel="1" number="2" checksum="d532bf1f" isList="true" registered="2">I can find common ground between the fiercest enemies, empathizing with them and always working toward peace.</element>
					<element type="List" name="Ideal" requiredLevel="1" checksum="1089d3aa" isList="true" registered="1">Tradition. The ancient traditions of worship and sacrifice must be preserved and upheld. (Lawful)</element>
					<element type="List" name="Bond" requiredLevel="1" checksum="904c692a" isList="true" registered="4">Everything I do is for the common people.</element>
					<element type="List" name="Flaw" requiredLevel="1" checksum="2f3c616a" isList="true" registered="6">Once I pick a goal, I become obsessed with it to the detriment of everything else in my life.</element>
					<element type="Proficiency" name="Insight" id="ID_PROFICIENCY_SKILL_INSIGHT" />
					<element type="Proficiency" name="Religion" id="ID_PROFICIENCY_SKILL_RELIGION" />
